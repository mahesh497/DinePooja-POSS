# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env is tracked for this project; keep local overrides private
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# local sqlite
prisma/*.db
prisma/*.db-journal
# dev.db ships with the repo so a fresh clone has seeded demo data
!prisma/dev.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Capacitor / Android
android/.gradle
android/app/build
android/build
android/local.properties
android/.idea
*.apk
*.aab
*.keystore
mobile/www/.DS_Store

