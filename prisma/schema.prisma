generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  CASHIER
  CAPTAIN
}

enum OrderType {
  DINE_IN
  PARCEL
  DELIVERY
}

enum OrderSource {
  WALK_IN
  PHONE
  ONLINE
}

enum OrderStatus {
  OPEN
  HOLD
  SETTLED
  VOIDED
  CANCELLED
  REFUNDED
}

enum CashEntryType {
  OPENING
  TOPUP
  WITHDRAW
  CLOSING
  SALE_CASH
}

enum ReservationStatus {
  BOOKED
  SEATED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum CouponType {
  PERCENT
  FLAT
}

enum DeliveryDutyStatus {
  AVAILABLE
  ON_TRIP
  OFFLINE
}

enum DeliveryTrackStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  ON_THE_WAY
  ARRIVED
  DELIVERED
  CANCELLED
}

enum KotStatus {
  PENDING
  PREPARING
  READY
  SERVED
  DELAYED
  CANCELLED
}

enum KotItemStatus {
  PENDING
  PREPARING
  SERVED
  VOIDED
  DELAYED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
}

enum TableStatus {
  FREE
  OCCUPIED
  RUNNING
  PRINTED
  RESERVED
  BILLING
}

model Outlet {
  id           String   @id @default(cuid())
  name         String
  address      String?
  phone        String?
  gstin        String?
  billPrefix   String   @default("DF")
  billCounter  Int      @default(1)
  logoUrl      String?
  cgstPercent  Float    @default(2.5)
  sgstPercent  Float    @default(2.5)
  packingChargeDefault   Float @default(10)
  deliveryChargeDefault  Float @default(40)
  serviceChargePercent   Float @default(0)
  containerChargeDefault Float @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users         User[]
  categories    Category[]
  halls         DiningHall[]
  tables        DiningTable[]
  orders        Order[]
  dayCloses     DayClose[]
  auditLogs     AuditLog[]
  customers     Customer[]
  cashEntries   CashEntry[]
  expenses      Expense[]
  reservations  Reservation[]
  coupons       Coupon[]
  deliveryBoys  DeliveryBoy[]
  feedbacks     Feedback[]
}

model DiningHall {
  id        String        @id @default(cuid())
  name      String
  sortOrder Int           @default(0)
  active    Boolean       @default(true)
  outletId  String
  outlet    Outlet        @relation(fields: [outletId], references: [id])
  tables    DiningTable[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CASHIER)
  active       Boolean  @default(true)
  outletId     String
  outlet       Outlet   @relation(fields: [outletId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]  @relation("OrderStaff")
  payments     Payment[]
  auditLogs    AuditLog[]
  kots         Kot[]
  cashEntries  CashEntry[]
  expenses     Expense[]
}

model Category {
  id        String     @id @default(cuid())
  name      String
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  outletId  String
  outlet    Outlet     @relation(fields: [outletId], references: [id])
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id             String         @id @default(cuid())
  code           String
  name           String
  description    String?
  price          Float
  isVeg          Boolean        @default(true)
  available      Boolean        @default(true)
  imageUrl       String?
  stock          Int            @default(100)
  popular        Boolean        @default(false)
  recommended    Boolean        @default(false)
  kitchenStation String         @default("Kitchen")
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id])
  variants       MenuVariant[]
  addons         MenuAddon[]
  orderItems     OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([code])
  @@index([code])
}

model MenuVariant {
  id         String   @id @default(cuid())
  name       String
  priceDelta Float    @default(0)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

model MenuAddon {
  id         String   @id @default(cuid())
  name       String
  price      Float    @default(0)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

model DiningTable {
  id         String      @id @default(cuid())
  name       String
  capacity   Int         @default(4)
  status     TableStatus @default(FREE)
  sortOrder  Int         @default(0)
  mergedInto String?
  hallId     String?
  hall       DiningHall? @relation(fields: [hallId], references: [id])
  outletId   String
  outlet     Outlet      @relation(fields: [outletId], references: [id])
  orders       Order[]
  reservations Reservation[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String
  type            OrderType   @default(DINE_IN)
  source          OrderSource @default(WALK_IN)
  status          OrderStatus @default(OPEN)
  guestCount      Int         @default(1)
  customerName    String?
  customerPhone   String?
  customerAddress String?
  onlinePlatform  String?
  driverName      String?
  deliveryBoyId   String?
  deliveryBoy     DeliveryBoy? @relation(fields: [deliveryBoyId], references: [id])
  deliveryStatus  DeliveryTrackStatus @default(PENDING)
  destLat         Float?
  destLng         Float?
  riderLat        Float?
  riderLng        Float?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  notes            String?
  packingCharge    Float       @default(0)
  deliveryCharge   Float       @default(0)
  serviceCharge    Float       @default(0)
  containerCharge  Float       @default(0)
  roundOff         Float       @default(0)
  subtotal         Float       @default(0)
  discountAmount   Float       @default(0)
  discountPercent  Float       @default(0)
  discountReason   String?
  cgstAmount       Float       @default(0)
  sgstAmount       Float       @default(0)
  total            Float       @default(0)
  paidAmount       Float       @default(0)
  voidReason      String?
  billPrintedAt   DateTime?
  occupiedAt      DateTime?
  settledAt       DateTime?
  outletId        String
  outlet          Outlet      @relation(fields: [outletId], references: [id])
  tableId         String?
  table           DiningTable? @relation(fields: [tableId], references: [id])
  createdById     String
  createdBy       User        @relation("OrderStaff", fields: [createdById], references: [id])
  items           OrderItem[]
  kots            Kot[]
  payments        Payment[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([outletId, status])
  @@index([createdAt])
}

model OrderItem {
  id           String        @id @default(cuid())
  name         String
  quantity     Int           @default(1)
  unitPrice    Float
  lineTotal    Float
  notes        String?
  isVeg        Boolean       @default(true)
  variantName  String?
  addonNames   String?
  voided       Boolean       @default(false)
  voidReason   String?
  kotSent      Boolean       @default(false)
  menuItemId   String?
  menuItem     MenuItem?     @relation(fields: [menuItemId], references: [id])
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kotItems     KotItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Kot {
  id          String    @id @default(cuid())
  kotNumber   Int
  station     String    @default("Kitchen")
  status      KotStatus @default(PENDING)
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  items       KotItem[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

model KotItem {
  id          String        @id @default(cuid())
  quantity    Int
  name        String
  notes       String?
  status      KotItemStatus @default(PENDING)
  kotId       String
  kot         Kot           @relation(fields: [kotId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String        @id @default(cuid())
  amount    Float
  method    PaymentMethod
  reference String?
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  takenById String
  takenBy   User          @relation(fields: [takenById], references: [id])
  createdAt DateTime      @default(now())
}

model DayClose {
  id            String   @id @default(cuid())
  outletId      String
  outlet        Outlet   @relation(fields: [outletId], references: [id])
  businessDate  DateTime
  totalSales    Float
  cashTotal     Float
  upiTotal      Float
  cardTotal     Float
  orderCount    Int
  voidCount     Int
  discountTotal Float
  notes         String?
  closedAt      DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   String?
  outletId  String
  outlet    Outlet   @relation(fields: [outletId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String
  email         String?
  address       String?
  loyaltyPoints Int      @default(0)
  creditBalance Float    @default(0)
  notes         String?
  outletId      String
  outlet        Outlet   @relation(fields: [outletId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([outletId, phone])
  @@index([outletId])
}

model CashEntry {
  id        String        @id @default(cuid())
  type      CashEntryType
  amount    Float
  note      String?
  outletId  String
  outlet    Outlet        @relation(fields: [outletId], references: [id])
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  createdAt DateTime      @default(now())

  @@index([outletId, createdAt])
}

model Expense {
  id        String   @id @default(cuid())
  category  String
  amount    Float
  note      String?
  outletId  String
  outlet    Outlet   @relation(fields: [outletId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([outletId, createdAt])
}

model Reservation {
  id         String            @id @default(cuid())
  guestName  String
  phone      String?
  partySize  Int               @default(2)
  tableId    String?
  table      DiningTable?      @relation(fields: [tableId], references: [id])
  reservedAt DateTime
  status     ReservationStatus @default(BOOKED)
  notes      String?
  outletId   String
  outlet     Outlet            @relation(fields: [outletId], references: [id])
  createdAt  DateTime          @default(now())

  @@index([outletId, reservedAt])
}

model Coupon {
  id        String     @id @default(cuid())
  code      String     @unique
  type      CouponType
  value     Float
  active    Boolean    @default(true)
  minOrder  Float      @default(0)
  expiresAt DateTime?
  outletId  String
  outlet    Outlet     @relation(fields: [outletId], references: [id])

  @@index([outletId])
}

model DeliveryBoy {
  id            String             @id @default(cuid())
  name          String
  phone         String
  active        Boolean            @default(true)
  rating        Float              @default(5)
  dutyStatus    DeliveryDutyStatus @default(AVAILABLE)
  vehicleType   String             @default("Bike")
  vehicleNumber String?
  lat           Float?
  lng           Float?
  lastSeenAt    DateTime?
  outletId      String
  outlet        Outlet             @relation(fields: [outletId], references: [id])
  orders        Order[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt

  @@index([outletId])
  @@index([dutyStatus])
}

model Feedback {
  id           String   @id @default(cuid())
  rating       Int
  comment      String?
  customerName String?
  orderId      String?
  outletId     String
  outlet       Outlet   @relation(fields: [outletId], references: [id])
  createdAt    DateTime @default(now())

  @@index([outletId, createdAt])
}
